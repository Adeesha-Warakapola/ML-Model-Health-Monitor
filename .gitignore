# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Virtual environment
.venv/
venv/
env/

# Datasets - downloaded from UCI, reproducible via `python explore_dataset.py`.
# Not committed: the project should fetch its own copy rather than vendor one.
data/
adult/

# Fitted preprocessor and other generated artifacts.
# Regenerate with `python validate_and_preprocess.py`.
artifacts/

# Monitoring history database - accumulates as the app runs, like a log file.
monitoring/

# Secrets - none are used by this project today, but if any are ever added
# (an API key, a Streamlit secrets.toml), they must never be committed.
.env
.env.*
*.pem
*.key
.streamlit/secrets.toml

# Logs, if any script is ever pointed at a log file instead of stdout.
*.log

# OS / editor
.DS_Store
.vscode/
.idea/
